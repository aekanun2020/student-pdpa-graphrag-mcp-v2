# ---- LLM provider used by the MCP server (keyword extraction only) ----
LLM_PROVIDER=openrouter
LLM_MODEL=gpt-oss-120b            # the server reads this name, not OPENROUTER_MODEL below
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# ---- Qdrant (started by docker-compose; change if you run your own) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Optional: let an LLM extract extra entities per section at startup (slow, costs API calls)
USE_LLM_EXTRACT=false

# ---- Retrieval tuning (optional) ----
# RRF constant k in score = sum(1 / (k + rank)). 60 = original RRF paper; 0 = Qdrant's default (k = 2)
RRF_K=60
# Max tokens of a section that BGE-M3 embeds. The longest section (26) is 810 tokens
CHUNK_MAX_LENGTH=1024

# Optional LLM settings (defaults shown)
# LLM_TEMPERATURE=0
# LLM_SEED=                        # empty = no seed is sent; a number is passed to the provider (best effort)

# Optional: where the MCP server listens inside the container (defaults shown)
# HOST=0.0.0.0
# PORT=8100

# Optional: Ollama instead of OpenRouter
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=<name of a model you have pulled; there is no default>

# ---- Agent side (labs/lab8) — not read by the MCP server ----
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
